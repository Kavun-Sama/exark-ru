{"id":1039079848763394,"text":"Императрица-лич"}
{"id":1039079848763395,"text":"Олигарх"}
{"id":1039079848763396,"text":"Монарх"}
{"id":1039079848763397,"text":"Экзарх"}
{"id":1039079848763398,"text":"Пороховая обезьяна"}
{"id":1039079848763399,"text":"Энсин"}
{"id":1039079848763400,"text":"Капитан"}
{"id":1039079848763401,"text":"Адмирал"}
{"id":1039079848763402,"text":"Победа коалиции"}
{"id":1039079848763403,"text":"Звёздный моряк"}
{"id":1039079848763404,"text":"Капер"}
{"id":1039079848763405,"text":"Незваный гость"}
{"id":1039079848763406,"text":"Звёзды сошлись"}
{"id":1039079848763407,"text":"Звёзды не сошлись"}
{"id":1039079848763408,"text":"Небесное созвездие"}
{"id":1039079848763409,"text":"Мастер кузни"}
{"id":1039079848763410,"text":"Философ"}
{"id":1039079848763411,"text":"Ковчеговед"}
{"id":1039079848763412,"text":"Полная анархия"}
{"id":1039079848763413,"text":"Корабль-призрак"}
{"id":1039079848763414,"text":"Главный уборщик"}
{"id":1039079848763415,"text":"Таксидермист"}
{"id":1039079848763416,"text":"Могильщик"}
{"id":1039079848763417,"text":"Верховный понтифик"}
{"id":1039079848763418,"text":"Глава гильдии"}
{"id":1039079848763419,"text":"Смотритель зверинца"}
{"id":1039079848763420,"text":"Разрушитель миров"}
{"id":592710164480,"text":"Победите, играя за Дом Ариох."}
{"id":1039079848763421,"text":"Победите, играя за Дом Мнесис."}
{"id":1039079848763422,"text":"Победите, играя за Дом в изгнании."}
{"id":1039079848763423,"text":"Победите, играя за Дом Империя."}
{"id":1039079848763424,"text":"Победите при рейтинге опасности 25 или выше."}
{"id":1039079848763425,"text":"Победите при рейтинге опасности 50 или выше."}
{"id":1039079848763426,"text":"Победите при рейтинге опасности 100 или выше."}
{"id":1039079848763427,"text":"Достигните ранга 1."}
{"id":1039079848763428,"text":"Достигните ранга 5."}
{"id":1039079848763429,"text":"Достигните ранга 10."}
{"id":1039079848763430,"text":"Достигните ранга 15."}
{"id":1039079848763431,"text":"Победите с союзным Домом."}
{"id":1039079848763432,"text":"Продержитесь в Пустоте не менее 60 секунд."}
{"id":1039079848763433,"text":"Уничтожьте корабль с сокровищами."}
{"id":1039079848763434,"text":"Уничтожьте Привратника."}
{"id":1039079848763435,"text":"Победите при рейтинге опасности 50 или выше, разместив в Звёздном атласе не менее 7 звёзд."}
{"id":1039079848763436,"text":"Победите при рейтинге опасности 50 или выше, не разместив в Звёздном атласе ни одной звезды."}
{"id":1039079848763437,"text":"Выкуйте 108 звёзд."}
{"id":1039079848763438,"text":"Победите, заполнив шкалу производства не менее 20 раз."}
{"id":1039079848763439,"text":"Победите, заполнив шкалу вдохновения не менее 20 раз."}
{"id":1039079848763440,"text":"Победите, собрав 10 реликвий. "}
{"id":1039079848763441,"text":"Победите, уничтожив не менее 24 врагов."}
{"id":1039079848763442,"text":"Победите за Дом Ариох, не назначив ни одного члена экипажа на здания ковчега."}
{"id":1039079848763443,"text":"Победите за Дом Мнесис, не имея на ковчеге зданий с тегом «Хлам»."}
{"id":1039079848763444,"text":"Победите за Дом в изгнании, не имея на ковчеге зданий с тегом «Орган»."}
{"id":1039079848763445,"text":"Победите за Дом Империя, не имея зданий с тегом «Погребение» ни на ковчеге, ни в грузовом отсеке."}
{"id":1039079848763446,"text":"Победите, имея на ковчеге не менее 10 священных зданий."}
{"id":1039079848763447,"text":"Победите, имея на ковчеге не менее 8 уникальных гильдейских зданий."}
{"id":1039079848763448,"text":"Победите, назначив на здания ковчега не менее 12 членов экипажа с тегом «Животное»."}
{"id":1039079848763449,"text":"Израсходуйте ядерную боеголовку."}
